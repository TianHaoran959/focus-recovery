{
  "manifest_version": 3,
  "name": "专注回收 Focus Recovery",
  "version": "1.3.3",
  "description": "电脑看课时的专注自检与回收工具：定时是/否自检、走神回收、网站学习/娱乐时长统计、页面静止/疑似离开识别，数据纯本地、零联网、不截屏。",
  "permissions": ["alarms", "storage", "tabs", "idle", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "专注回收",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
